# Engine Labs — root ignore rules (created by T0-8 software-engineer-subagent, 2026-09-10)

# Reference clones (pinned third-party source; never versioned here)
.reference/

# Dependencies
node_modules/
.pnpm-store/
.venv/
venv/
__pycache__/
*.pyc

# Build outputs
dist/
build/
target/
out/
.vite/
.turbo/
*.tsbuildinfo

# Environment files — never commit values; keep examples
.env
.env.*
!.env.example
!.env.*.example

# Coverage and test artifacts
coverage/
.nyc_output/
.pytest_cache/
.mypy_cache/
.ruff_cache/
playwright-report/
test-results/

# OS and editor noise
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-error.log*

# Tauri / Rust local artifacts
src-tauri/target/
src-tauri/gen/schemas/

# Local secrets or key material must never be tracked
*.pem
*.key
*.p12
